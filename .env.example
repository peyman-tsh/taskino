# Server
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3001

# MongoDB
MONGODB_URI=mongodb://localhost:27017/taskino

# Swagger
SWAGGER_PATH=api/docs
SWAGGER_DOCS_PATH=api/docs-json

# Security
BCRYPT_SALT_ROUNDS=10

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Deployment maintenance warning authentication
MAINTENANCE_DEPLOY_TOKEN=replace-with-a-long-random-secret
MAINTENANCE_API_URL=http://127.0.0.1:3000/api/maintenance/restart-warning/deploy
MAINTENANCE_FINISH_API_URL=http://127.0.0.1:3000/api/maintenance/restart-warning/finish
PM2_APP_NAME=taskino
